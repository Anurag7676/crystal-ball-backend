{
  "name": "crystal-ball-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + TypeScript API for the OomniEye Approvals AI assistant (Crystal Ball take-home)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/data/approval-policy.md','dist/data/approval-policy.md')\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "seed": "tsx scripts/seed.ts",
    "contract:export": "tsx scripts/export-contract.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "mongoose": "^9.11.1",
    "openai": "^7.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
