PORT=4000
FRONTEND_URL=http://localhost:3000
# Optional. Leave empty to use the JSON fixture + in-memory conversations.
MONGODB_URI=

# AI provider. Claude is used when ANTHROPIC_API_KEY is set, otherwise OpenAI.
# Set AI_PROVIDER=anthropic|openai to choose explicitly. With no key, every AI
# action returns its deterministic fallback.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
