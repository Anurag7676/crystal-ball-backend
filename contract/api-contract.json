{
  "requests": {
    "greeting": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "language": {
          "type": "string",
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    },
    "summary": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "language": {
          "type": "string",
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    },
    "chat": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "language": {
          "type": "string",
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "sessionId",
        "message"
      ],
      "additionalProperties": false
    },
    "help": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "language": {
          "type": "string",
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "sessionId",
        "message"
      ],
      "additionalProperties": false
    },
    "teach": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "language": {
          "type": "string",
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "sessionId",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "responses": {
    "approvals": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^apr-\\d{3}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "folder",
                  "video",
                  "pdf",
                  "image"
                ]
              },
              "submittedBy": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending_review",
                  "approved",
                  "rejected"
                ]
              },
              "submittedDateLabel": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "title",
              "type",
              "submittedBy",
              "status",
              "submittedDateLabel"
            ]
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pendingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "facets": {
          "type": "object",
          "properties": {
            "type": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "value",
                  "count"
                ]
              }
            },
            "submittedBy": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "value",
                  "count"
                ]
              }
            },
            "status": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "value",
                  "count"
                ]
              }
            }
          },
          "required": [
            "type",
            "submittedBy",
            "status"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "mongodb",
            "fixture"
          ]
        }
      },
      "required": [
        "approvals",
        "total",
        "page",
        "pageSize",
        "pageCount",
        "pendingCount",
        "facets",
        "source"
      ]
    },
    "error": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "validation_error",
                "rate_limited",
                "not_found",
                "ai_unavailable",
                "internal_error"
              ]
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "message"
                ]
              }
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "error"
      ]
    }
  },
  "sseEvents": {
    "meta": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "greeting",
            "summary",
            "chat",
            "help",
            "teach"
          ]
        },
        "requestId": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "action",
        "requestId"
      ]
    },
    "delta": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "summary"
            },
            "summary": {
              "type": "object",
              "properties": {
                "pendingCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "overview": {
                  "type": "string",
                  "minLength": 1
                },
                "priorityItems": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "approvalId": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "approvalId",
                      "title",
                      "reason"
                    ]
                  }
                },
                "recommendations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "orderingNote": {
                  "type": "string"
                }
              },
              "required": [
                "pendingCount",
                "overview",
                "priorityItems",
                "recommendations",
                "orderingNote"
              ]
            }
          },
          "required": [
            "kind",
            "summary"
          ]
        }
      ]
    },
    "error": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "validation_error",
            "rate_limited",
            "not_found",
            "ai_unavailable",
            "internal_error"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "done": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "ai",
            "fallback"
          ]
        },
        "fallbackReason": {
          "type": "string",
          "enum": [
            "timeout",
            "provider_error",
            "missing_api_key",
            "invalid_output"
          ]
        },
        "citedSources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "source"
      ]
    }
  }
}
